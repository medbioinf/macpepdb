(common_headers) {
    header /* {
        -Server
        -Via
        # Headers set by upstream (e.g. the frontend container) are kept.
        # The `?` prefix only sets a header if it is absent, `defer` evaluates it
        # after the upstream response was copied, so API, 503 and redirect responses are covered too.
        ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
        ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        ?X-Frame-Options "SAMEORIGIN"
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
        ?Permissions-Policy "geolocation=(), midi=(), notifications=(), push=(), sync-xhr=(), microphone=(), camera=(), magnetometer=(), gyroscope=(), fullscreen=(), payment=()"
        ?X-Permitted-Cross-Domain-Policies "none"
        ?Cache-Control "no-cache"
        defer
    }
}

