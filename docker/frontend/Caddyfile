{
    auto_https off
}

:80 {
	root * /usr/share/caddy

	header {
        -Server
        -Via
        Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; <CSP_HEADER_ATTR> <CONNECT_SRC>"
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), midi=(), notifications=(), push=(), sync-xhr=(), microphone=(), camera=(), magnetometer=(), gyroscope=(), fullscreen=(), payment=()"
        X-Permitted-Cross-Domain-Policies none
    }

	# Always revalidate entry point and runtime config
	@revalidate path / /index.html /assets/config.toml
	header @revalidate Cache-Control "no-cache"

	try_files {path} {path}/ /index.html
	file_server
}
